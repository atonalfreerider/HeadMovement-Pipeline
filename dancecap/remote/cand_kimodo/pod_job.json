 ],
 "notes": [
  "Kimodo constraint-only gap fill (no text encoder, no Llama); weights Kimodo-SOMA-RP-v1.2 (NVIDIA Open Model License) downloaded on the pod at a pinned revision; uploads only joint arrays of the reference fit (no frames, no video)"
 ]
}