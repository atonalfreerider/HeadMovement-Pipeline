  "dancecap/work/john_lula/lhmpp_preview/renders/lhmpp_video8_photo/turntable/tt00.png",
  "dancecap/work/john_lula/lhmpp_preview/renders/lhmpp_video8_photofull/turntable/tt00.png",
  "dancecap/work/john_lula/lhmpp_preview/renders/lhmpp_video8/clip_vr_seat/0119.png",
  "dancecap/work/john_lula/lhmpp_preview/renders/lhmpp_video8_photo/clip_vr_seat/0119.png",
  "dancecap/work/john_lula/lhmpp_preview/renders/lhmpp_video8_photofull/clip_vr_seat/0119.png"
 ],
 "after_download": [
