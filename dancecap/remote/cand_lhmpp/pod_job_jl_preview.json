  "dancecap/work/john_lula/lhmpp_preview/input/"
 ],
 "exclude": [
  "dancecap/work/runpod/pywheels",
  "dancecap/work/runpod/wheelhouse",
  "mamma-turing"
 ],
 "env": {
  "LHMPP_COMMIT": "906b5d9fb967ab42efb92f6fa55bf22cac86b653",
  "LHMPP_ROOT": "/workspace/lhmpp_cand/LHM-plusplus",
  "LHMPP_VENV": "/workspace/lhmpp_cand/venv",
  "LHMPP_MODEL": "LHMPP-700M-PixelShuffle",
  "TORCH_HOME": "/workspace/lhmpp_cand/torch_home",
  "HF_HOME": "/workspace/lhmpp_cand/hf_home"
 },
 "commands": [
  {
   "name": "install",
   "timeout_min": 35,
   "cmd": "bash remote/cand_lhmpp/install.sh"
  },
  {
   "name": "render",
   "timeout_min": 20,
   "cmd": "/workspace/lhmpp_cand/venv/bin/python remote/cand_lhmpp/lhmpp_compare_pod.py --input work/john_lula/lhmpp_preview/input --out work/john_lula/lhmpp_preview/pod_out --renders work/john_lula/lhmpp_preview/renders --variants lhmpp_video8,lhmpp_video8_photo,lhmpp_video8_photofull"
  },
  {
   "name": "score",
   "timeout_min": 6,
   "optional": true,
   "cmd": "(python -m pip install -q --no-deps lpips==0.1.4 || echo 'lpips install failed: no LPIPS'); python -m dancecap.mono4d.jl_lhmpp_preview score"
  }
 ],
 "outputs": [
  "dancecap/work/john_lula/lhmpp_preview/pod_out/",
