 "outputs": [
  "dancecap/work/larissa_kadu_38/mono4d/compare/lhmpp/pod_out/",
  "dancecap/work/larissa_kadu_38/mono4d/compare/renders/lhmpp_1phone/",
  "dancecap/work/larissa_kadu_38/mono4d/compare/renders/lhmpp_8phone/"
 ],
 "verify": [
  "dancecap/work/larissa_kadu_38/mono4d/compare/lhmpp/pod_out/lhmpp_compare_pod.json",
  "dancecap/work/larissa_kadu_38/mono4d/compare/renders/lhmpp_1phone/i0_c03.png",
  "dancecap/work/larissa_kadu_38/mono4d/compare/renders/lhmpp_8phone/i0_c03.png",
  "dancecap/work/larissa_kadu_38/mono4d/compare/renders/lhmpp_1phone/clip_vr_seat/0104.png",
  "dancecap/work/larissa_kadu_38/mono4d/compare/renders/lhmpp_8phone/clip_vr_seat/0104.png"
 ],
 "after_download": [
  "python -m dancecap.mono4d.cand_lhmpp compare-import --session <sid>"
 ],
 "notes": [
  "LHM++ (LHMPP-700M-PixelShuffle, CC BY-NC 4.0 weights) avatars of both dancers from phone-06 crops (lhmpp_1phone) and from 2 crops of each of the 8 phones (lhmpp_8phone), posed with the reference SMPL-X and rendered into every view of mono4d/compare/views.json (both dancers together); weights stay on the pod; crops and frames go to our own pod only (owner consent 2026-10-19)"
 ]
}