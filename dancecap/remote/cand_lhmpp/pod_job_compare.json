   "timeout_min": 20,
   "cmd": "/workspace/lhmpp_cand/venv/bin/python remote/cand_lhmpp/lhmpp_compare_pod.py --input work/larissa_kadu_38/mono4d/compare/lhmpp/input --out work/larissa_kadu_38/mono4d/compare/lhmpp/pod_out --renders work/larissa_kadu_38/mono4d/compare/renders --variants lhmpp_1phone,lhmpp_8phone"
  },
  {
   "name": "score",
